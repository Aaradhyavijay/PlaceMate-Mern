@tokenA = {{loginA.response.body.token}}
@tokenB = {{loginB.response.body.token}}
@tokenS = {{loginS.response.body.token}}


### Register Recruiter A
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Recruiter A",
  "email": "recruitera@test.com",
  "password": "123456",
  "role": "recruiter"
}


### Login Recruiter A
# @name loginA
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "recruitera@test.com",
  "password": "123456"
}
### Register Recruiter B
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Recruiter B",
  "email": "recruiterb@test.com",
  "password": "123456",
  "role": "recruiter"
}

### Login Recruiter B
# @name loginB
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "recruiterb@test.com",
  "password": "123456"
}

### Register Student
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Student Test",
  "email": "student@test.com",
  "password": "123456",
  "role": "student"
}

### Login Student
# @name loginS
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "student@test.com",
  "password": "123456"
}


### Test 1 - A's own jobs
GET http://localhost:5000/api/jobs/mine
Authorization: Bearer {{tokenA}}


### Test 2 - A creates a job
# @name createJob
POST http://localhost:5000/api/jobs
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "title": "Test Job",
  "company": "Test Co",
  "description": "Testing",
  "location": "Jaipur"
}


### Test 3 - A updates own job
PUT http://localhost:5000/api/jobs/{{createJob.response.body._id}}
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "package": "₹50,000/month"
}


### Test 4 - B tries to update A's job
PUT http://localhost:5000/api/jobs/{{createJob.response.body._id}}
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "package": "₹99,999/month"
}


### Test 5 - Student tries to delete A's job
DELETE http://localhost:5000/api/jobs/{{createJob.response.body._id}}
Authorization: Bearer {{tokenS}}


### Test 6 - B tries to delete A's job
DELETE http://localhost:5000/api/jobs/{{createJob.response.body._id}}
Authorization: Bearer {{tokenB}}


### Test 7 - A deletes own job
DELETE http://localhost:5000/api/jobs/{{createJob.response.body._id}}
Authorization: Bearer {{tokenA}}


### Register Admin (as recruiter first)
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Admin Test",
  "email": "admin@test.com",
  "password": "123456",
  "role": "recruiter"
}


### Login Admin
# @name loginAdmin
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "admin123"
}


### Admin Test 1 - A creates a job (should be pending)
# @name pendingJob
POST http://localhost:5000/api/jobs
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "title": "Approval Test Job",
  "company": "Test Co",
  "description": "Waiting for admin",
  "location": "Jaipur"
}


### Admin Test 2 - Admin sees pending jobs
GET http://localhost:5000/api/admin/jobs/pending
Authorization: Bearer {{loginAdmin.response.body.token}}


### Admin Test 3 - Recruiter A tries admin route
GET http://localhost:5000/api/admin/jobs/pending
Authorization: Bearer {{loginA.response.body.token}}


### Admin Test 4 - Admin approves the job
PUT http://localhost:5000/api/admin/jobs/{{pendingJob.response.body._id}}/approve
Authorization: Bearer {{loginAdmin.response.body.token}}


### Admin Test 5a - A creates 2nd job (pending)
# @name rejectJob
POST http://localhost:5000/api/jobs
Content-Type: application/json
Authorization: Bearer {{loginA.response.body.token}}

{
  "title": "Reject Test Job",
  "company": "Test Co",
  "description": "To be rejected",
  "location": "Jaipur"
}

### Admin Test 5b - Admin rejects it
PUT http://localhost:5000/api/admin/jobs/{{rejectJob.response.body._id}}/reject
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "reason": "Missing salary details"
}


### Admin Test 6 - Public list shows only approved
GET http://localhost:5000/api/jobs


### App Test 1 - Student applies to REJECTED job (should fail)
POST http://localhost:5000/api/applications
Content-Type: application/json
Authorization: Bearer {{loginS.response.body.token}}

{
  "job": "{{rejectJob.response.body._id}}"
}

### App Test 2 - Student applies to APPROVED job
POST http://localhost:5000/api/applications
Content-Type: application/json
Authorization: Bearer {{loginS.response.body.token}}

{
  "job": "{{pendingJob.response.body._id}}"
}

### App Test 3 - Recruiter B views A's job applicants (should fail)
GET http://localhost:5000/api/applications/job/{{pendingJob.response.body._id}}
Authorization: Bearer {{loginB.response.body.token}}


### Elig Test 1 - Student sets profile
PUT http://localhost:5000/api/students/profile
Content-Type: application/json
Authorization: Bearer {{loginS.response.body.token}}

{
  "branch": "IT",
  "graduationYear": 2028,
  "cgpa": 7.7,
  "backlogs": 0,
  "skills": ["React", "JavaScript"]
}


### Elig Test 2 - A creates a strict job
# @name strictJob
POST http://localhost:5000/api/jobs
Content-Type: application/json
Authorization: Bearer {{loginA.response.body.token}}

{
  "title": "Strict Job",
  "company": "Test Co",
  "description": "High criteria",
  "location": "Jaipur",
  "eligibility": {
    "minCGPA": 8,
    "branches": ["CSE"],
    "maxBacklogs": 0,
    "graduationYear": 2027
  },
  "skillsRequired": ["React", "Node"]
}


### Elig Test 3 - Student checks eligibility for strict job
GET http://localhost:5000/api/jobs/{{strictJob.response.body._id}}/eligibility
Authorization: Bearer {{loginS.response.body.token}}


### Elig Test 4 - Admin approves strict job
PUT http://localhost:5000/api/admin/jobs/{{strictJob.response.body._id}}/approve
Authorization: Bearer {{loginAdmin.response.body.token}}

### Elig Test 5 - Student applies to strict job (should be blocked)
POST http://localhost:5000/api/applications
Content-Type: application/json
Authorization: Bearer {{loginS.response.body.token}}

{
  "job": "{{strictJob.response.body._id}}"
}